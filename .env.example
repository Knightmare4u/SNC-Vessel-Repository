SECRET_KEY=
DEBUG=
FILE_STORAGE_ROOT=./vessel_files
ARCHIVE_ROOT=./vessel_files/ARCHIVE

# Docker volume mount path for vessel files. This is the path that will be used by the application to access the vessel files.
VESSEL_STORAGE_PATH=

# Site address used for links in emails, e.g. https://snseafiles.sinceregp.com
BASE_URL=

# Sign in with Microsoft: values from the Entra ID app registration. The button shows once these four are set
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Must match the app registration's redirect URI exactly
MICROSOFT_REDIRECT_URI=https://snseafiles.sinceregp.com/auth/microsoft/callback/
# Comma-separated; only Microsoft accounts on these domains can sign in
MICROSOFT_ALLOWED_DOMAINS=sinceregp.com

# Database (only needed if DEBUG=false, uses postgres; DEBUG=true uses sqlite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email (signing notifications). Set EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend to print emails instead of sending them
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Seconds to wait for the mail server (default 30)
EMAIL_TIMEOUT=

# pgAdmin (only needed if running via docker-compose)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
